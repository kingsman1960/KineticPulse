# Jetson kineticpulse must be running with monitoring.enabled.
KINETICPULSE_MONITORING_HTTP_URL=http://127.0.0.1:8790/monitoring

# Server-side SQLite path. Relative paths resolve from the dashboard process.
# Default when omitted: ./runtime/monitoring.db
MONITORING_DB_PATH=./runtime/monitoring.db

# Maximum recent events included in each unchanged monitoring API response.
MONITORING_EVENT_LIMIT=30

# Old database rows are removed once when the SQLite store opens.
MONITORING_RETENTION_DAYS=30

# Existing caregiver signaling configuration.
NEXT_PUBLIC_SIGNALING_HTTP_BASE=http://localhost:8787
NEXT_PUBLIC_SIGNALING_WS_BASE=ws://localhost:8787/ws
NEXT_PUBLIC_CAREGIVER_TOKEN=replace_caregiver_token
