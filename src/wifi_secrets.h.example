#pragma once
// Copy to wifi_secrets.h (gitignored). Use a PHONE HOTSPOT (WPA2-PSK).
// Campus eduroam / enterprise Wi-Fi will NOT work with WiFi.begin().
//
// Steps:
//   1. Phone: hotspot ON (note SSID + password)
//   2. Laptop: join that hotspot
//   3. python scripts/tcp_wristband_host.py   → copy printed SERVER_IP
//   4. Fill WIFI_* + SERVER_IP below, then:
//        pio run -e seeed_xiao_esp32s3 -t upload

#define WIFI_SSID "YOUR_HOTSPOT_SSID"
#define WIFI_PASSWORD "YOUR_HOTSPOT_PASSWORD"
#define SERVER_IP "192.168.x.x"
#define SERVER_PORT 5555
